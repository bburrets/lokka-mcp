# Microsoft Entra (Azure AD) Configuration
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Optional: Interactive Authentication
# USE_INTERACTIVE=true
# REDIRECT_URI=http://localhost:3000

# Optional: Client Token Authentication
# USE_CLIENT_TOKEN=true
# ACCESS_TOKEN=your-access-token-here

# Optional: Database Configuration (for audit logging)
POSTGRES_PASSWORD=strong-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lokka
POSTGRES_USER=lokka

# Optional: Redis Configuration (for caching)
REDIS_PASSWORD=strong-redis-password-here
REDIS_HOST=redis
REDIS_PORT=6379

# Node Environment
NODE_ENV=production

# Logging Level
LOG_LEVEL=info

# Optional: Custom MCP Server Port
# MCP_PORT=3000